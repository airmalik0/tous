{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imbim-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "imbim.online", "custom_domain": true },
    { "pattern": "www.imbim.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Неизвестные пути отдают index.html — дальше маршрут разбирает React Router.
    // Известные отдают предрендеренный HTML из dist/<путь>/index.html.
    "not_found_handling": "single-page-application",
    // Канонические адреса без слэша на конце: /uslugi/lending, а не /uslugi/lending/.
    // По умолчанию (auto-trailing-slash) Cloudflare редиректил бы на версию
    // со слэшем, и canonical указывал бы на адрес, который сам себя редиректит.
    "html_handling": "drop-trailing-slash",
    // Статику Worker не трогает — просыпается только на /api/*.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
