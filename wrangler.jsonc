{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "imbim-site",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "imbim.online", "custom_domain": true },
    { "pattern": "www.imbim.online", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Vite-приложение: неизвестные пути отдают index.html.
    // /thank-you/ существует как файл и отдаётся напрямую, до фолбэка.
    "not_found_handling": "single-page-application",
    // Статику Worker не трогает — просыпается только на /api/*.
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
