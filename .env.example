# Серверные переменные для /api/lead (Cloudflare Worker).
# НЕ префиксуй VITE_ — иначе Vite инлайнит значение в публичный клиентский бандл.
#
# Прод: задаются как секреты Worker, а не файлом —
#   wrangler secret put TG_BOT_TOKEN
#   wrangler secret put TG_CHAT_ID
#
# Локально (`npm run cf:dev`): скопируй в .dev.vars, он в .gitignore.
TG_BOT_TOKEN=your-telegram-bot-token
TG_CHAT_ID=your-admin-chat-id
